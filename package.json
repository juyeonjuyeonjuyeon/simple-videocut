{
  "name": "simple-videocut",
  "description": "개인용 브라우저 및 macOS 영상 편집기",
  "author": "juyeon",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:native": "node --test electron/ffmpeg-args.test.mjs electron/native-project-store.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run test:native && npm run build",
    "desktop:dev": "DESKTOP_BUILD=1 npm run build && electron .",
    "desktop:build": "DESKTOP_BUILD=1 npm run build && electron-builder --mac dir",
    "desktop:package": "DESKTOP_BUILD=1 npm run build && electron-builder --mac dmg",
    "desktop:test": "node scripts/packaged-launch.mjs && node scripts/desktop-close-test.mjs && node scripts/desktop-smoke.mjs && node scripts/desktop-e2e.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.juyeon.simplecut",
    "productName": "SimpleCut",
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{ "from": "node_modules/ffmpeg-static/ffmpeg", "to": "ffmpeg" }],
    "mac": { "target": ["dmg"], "category": "public.app-category.video", "icon": "public/icon-512.png", "identity": "-" }
  }
}
